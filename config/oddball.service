[Unit]
# Mr Odd Ball — the assistant itself. Wake word, capture, STT, the copilot's router, voice.
#
# A systemd USER unit, not a system one, and that is not a style choice: he needs the
# microphone and the speaker, and on this Pi both live behind PipeWire, which is itself a
# per-user service. A system unit runs before any of that exists and would find no audio.
#
# `loginctl show-user ironi -p Linger` is already `Linger=yes` on this box, which is what lets
# a user unit start at BOOT rather than waiting for somebody to log in. If that is ever turned
# off, this unit silently stops starting on power-up — re-enable it with:
#     sudo loginctl enable-linger ironi
#
# Deliberately has NOTHING to do with the screen. hud_bridge broadcasts to whoever is connected
# and does not care whether anyone is, so he must work with no display attached. The face is a
# separate autostart entry (config/oddball-face.desktop) and either can be running without the
# other.
#
# DO NOT ADD `Environment=WAYLAND_DISPLAY=wayland-0` HERE. (D10, 2026-08-21.)
#
# It looks like the fix for "he cannot open Firefox" and it is not. Three reasons, in order of
# how long each takes to bite:
#
#   1. It is written before the compositor exists. This unit starts at BOOT, because of
#      lingering, and labwc is not up yet.
#   2. labwc picks a different socket number after a session restart, so a baked-in value is
#      right until the first time LB restarts the desktop and silently wrong forever after —
#      presenting as "he stopped being able to open anything".
#   3. This unit does not need a display at all. The value is consumed at LAUNCH time by
#      `tools/app_launcher.py`, which globs $XDG_RUNTIME_DIR for the socket at the moment it is
#      needed and refuses to launch when there is none. Storing the answer here puts it in the
#      one place that cannot be re-read when it changes.
#
# Note that the desktop session DOES import its environment into the systemd user manager at
# login, so a unit restarted after login inherits WAYLAND_DISPLAY while the same unit started at
# boot does not. That is why the original bug was intermittent rather than absolute, and it is
# exactly the kind of accident that makes a bad fix look like it worked.
#
# KillMode=control-group is also deliberate and stays. It is what makes `systemctl --user stop
# oddball` clean. It is ALSO why applications he opens must not live in this unit's cgroup —
# they would die on the next restart or deploy — so each one gets its own transient unit via
# `systemd-run --user`, named `oddball-app-<id>-<timestamp>`. See docs/DECISIONS.md D10.
Description=Mr Odd Ball — voice assistant
Documentation=file:%h/mr-odd-ball/docs/DEPLOY.md
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service wireplumber.service

# The graphical session, for the boxes where systemd owns it.
#
# On LB's Pi it owns nothing: lightdm execs labwc-pi, which execs labwc, and
# `systemctl --user is-active graphical-session.target` reports **inactive** (measured
# 2026-08-23). Ordering against a target that never activates imposes no wait, so on THIS
# machine these two lines are inert and `ExecStartPre` below is what actually does the job.
#
# They are still declared, for two reasons: they are correct on any box whose session IS
# systemd-managed, and the day something starts populating that target here, the ordering is
# already right. What they are NOT is the fix — see tools/wait_for_display.sh.
After=graphical-session.target
Wants=graphical-session.target

# Give up after 3 failures in 5 minutes rather than restarting forever. A microphone that has
# gone into digital silence (the C270 does this) fails identically every time, and a service
# that respawns into it for hours only makes the journal harder to read.
#
# These belong in [Unit]. They were in [Service] until 2026-08-21, where systemd IGNORES them —
# `systemd-analyze --user verify` says so out loud: "Unknown key 'StartLimitIntervalSec' in
# section [Service], ignoring." So the rate limit had never once been in force, and a unit that
# failed identically forever would have gone on doing it forever. Found while reinstalling this
# file for the D10 comments; nothing to do with that work, and a good argument for running
# `systemd-analyze verify` after any edit here.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=%h/mr-odd-ball
# --save-captures is ON, added 2026-08-14 while chasing false wakes.
#
# The flag has existed since 2026-08-13 and had never been used, so every misheard question
# and every spurious wake up to that point was unrecoverable — `docs/STATE.md` had listed
# turning it on as the next concrete step for a day. LB's "he keeps waking up as if i am
# calling him" is exactly the report that cannot be diagnosed from a log alone: the log says a
# frame scored 0.42, and only the audio says whether that was the television, the room, or LB.
#
# Cost: a 16kHz mono WAV per captured utterance, ~50KB for 1.6s. At the observed 0.45 wakes a
# minute that is ~2MB/hour against 97GB free. `captures/` is gitignored.
# Wait for the compositor's environment before starting. `Linger=yes` starts the user manager
# at BOOT, so without this the assistant came up ~8 seconds after power-on, while labwc was
# still loading, and inherited no WAYLAND_DISPLAY at all (D10 defect 1, measured again
# 2026-08-22). The script always exits 0 — a missing screen must never stop a VOICE assistant.
ExecStartPre=%h/mr-odd-ball/tools/wait_for_display.sh
ExecStart=%h/mr-odd-ball/venv/bin/python main.py --voice --log %h/mr-odd-ball/oddball.log --save-captures %h/mr-odd-ball/captures

# ExecStart was orchestrator/run_wake.py until 2026-08-19. It is main.py --voice now: the
# assistant and the EE copilot are one program, and main.py is its entry point. The flags are
# passed straight through to engine/run_voice.py, which is where run_wake.py ended up.
#
# He no longer starts llama-server. The local tier went in the merge (D1), so this unit starts
# one process and gets one — every brain is a network call now. KillMode=control-group remains
# the default and is still what makes `systemctl --user stop oddball` clean, it just has less
# to clean up.
#
# TimeoutStartSec was 180 for a cold GGUF off the SD card. faster-whisper is now the only slow
# load left, so this could come down — left alone until somebody has actually timed a cold boot,
# because a start timeout that is too tight fails as "he did not come up after a reboot".
# Must exceed wait_for_display.sh's ceiling (90s) plus real startup, or systemd kills the
# unit while it is legitimately waiting — which would look exactly like a crash loop.
TimeoutStartSec=300

Restart=on-failure
RestartSec=5
# The rate limit that goes with these two lives in [Unit], NOT here — see the note up there.

# Audio must not be starved by anything else on a 4-core box. This mattered more when
# llama-server took all four threads to think; the remaining CPU cost is faster-whisper on one
# utterance at a time, and the priority is cheap to keep.
Nice=-5

[Install]
WantedBy=default.target
