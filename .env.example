# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# --- required ---------------------------------------------------------------------------
#
# https://aistudio.google.com/apikey — the free tier is **20 requests per model per day**,
# not the ~1,500 this file used to claim. That correction is D3, and the whole free-tier
# architecture (orchestrator/instant.py, launch_intent, note_intent, route_hint, corpus_hint)
# exists because of it.
GOOGLE_API_KEY=

# --- optional ---------------------------------------------------------------------------
#
# Gives Mr Odd Ball's CHARACTER its own quota, on a provider that is not Google.
#
# Without this, PERSONA runs on `gemini-3.5-flash-lite` — the same model name as the ROUTER,
# so chit-chat and routing share one bucket of 20 a day and every joke costs a routed turn.
# With it, PERSONA goes to OpenRouter and draws on nothing Google counts.
#
# https://openrouter.ai/keys. The default model is `minimax/minimax-m2.7:free`, chosen because
# PERSONA is also GENERAL — the only route that can FILE AN UPLOAD — so the model must support
# tool calling or `save_to_vault` and `process_inbox_file` break silently. Verified 2026-08-28:
# it accepts `tools` and `tool_choice`, 196,608-token context.
#
# Override the model with ODDBALL_PERSONA_MODEL. A name with no "/" in it is read as a Gemini
# model and the OpenRouter path is skipped, so switching back is one variable.
OPENROUTER_API_KEY=

# Your Canvas calendar feed (Account -> Settings -> Calendar Feed). Read-only, and it IS a
# password with a scheme on the front — see D22/L17.
ODDBALL_CANVAS_ICS=
