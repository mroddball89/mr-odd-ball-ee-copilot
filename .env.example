# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.
#
# --- required ---------------------------------------------------------------------------
#
# https://aistudio.google.com/apikey — the free tier is **20 requests per model per day**,
# not the ~1,500 this file used to claim. That correction is D3, and the whole free-tier
# architecture (orchestrator/instant.py, launch_intent, note_intent, route_hint, corpus_hint)
# exists because of it.
GOOGLE_API_KEY=

# --- optional ---------------------------------------------------------------------------
#
# Gives Mr Odd Ball's CHARACTER its own quota, on a provider that is not Google.
#
# Without this, PERSONA runs on `gemini-3.5-flash-lite` — the same model name as the ROUTER,
# so chit-chat and routing share one bucket of 20 a day and every joke costs a routed turn.
# With it, PERSONA goes to OpenRouter and draws on nothing Google counts.
#
# https://openrouter.ai/keys. The default model is `minimax/minimax-m2.7:free`, chosen because
# PERSONA is also GENERAL — the only route that can FILE AN UPLOAD — so the model must support
# tool calling or `save_to_vault` and `process_inbox_file` break silently. Verified 2026-08-28:
# it accepts `tools` and `tool_choice`, 196,608-token context.
#
# Override the model with ODDBALL_PERSONA_MODEL. A name with no "/" in it is read as a Gemini
# model and the OpenRouter path is skipped, so switching back is one variable.
OPENROUTER_API_KEY=

# Your Canvas calendar feed (Account -> Settings -> Calendar Feed). Read-only, and it IS a
# password with a scheme on the front — see D22/L17.
ODDBALL_CANVAS_ICS=

# --- routing on this machine instead of on the free tier ---------------------------------
#
# Set this to a model you have pulled and the ROUTER stops calling Gemini entirely. Unset it
# and nothing changes. Opt-in **by model name**, the same rule ODDBALL_PERSONA_MODEL follows:
# a config that switches provider because a URL or a key happens to be present switches by
# accident, and that cost a day on 2026-08-29.
#
#     ollama serve
#     ollama pull qwen2.5:1.5b
#     setx ODDBALL_LOCAL_ROUTER qwen2.5:1.5b
#
# Prove it first — `python tools/evaluate_local_router.py` replays real past utterances through
# the candidate and scores it against the route the rig actually took. Do not skip this: the
# router decides which of eleven agents answers, and a router that is wrong 30% of the time is
# worse than one that costs money.
#
# Routing goes back to Gemini for one turn if Ollama is not answering, with a WARNING in
# data/oddball.log. Set ODDBALL_LOCAL_ROUTER_STRICT=1 to fail the turn instead of paying.
ODDBALL_LOCAL_ROUTER=

# The endpoint. Either spelling works — the "/v1" suffix is stripped, because structured
# output lives on Ollama's native /api/chat and not on its OpenAI-compatible surface.
# ODDBALL_LOCAL_ROUTER_BASE_URL=http://127.0.0.1:11434/v1

# How long Ollama keeps the model in RAM between turns. The default of 5 minutes means paying
# the cold-load cost after every coffee; 1.5B at Q4 is about a gigabyte of the 32 GB here.
# ODDBALL_LOCAL_ROUTER_KEEP_ALIVE=30m

# How long one local classification may take. **It is clamped below ROUTER_DEADLINE_S (20s)
# whatever you put here, and that clamp is not tidiness.** engine/core.py abandons the router
# thread at the deadline and answers from GENERAL; if the local call is still running it fails
# LATER, and the fallback then buys a Gemini request for a turn LB has already been answered.
# A timeout longer than the deadline is a bill, not a longer wait. Leave it unset.
# ODDBALL_LOCAL_ROUTER_TIMEOUT_S=18
